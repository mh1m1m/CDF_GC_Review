{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd apps/web && npm ci --no-audit --no-fund",
  "buildCommand": "cd apps/web && npm run build",
  "outputDirectory": "apps/web/dist",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{apps/web/**,tests/test_*.py,tests/**/__pycache__/**,docs/**,AI_AGENT_FORENSIC_AUDIT/**,dist/**,EVIDENCE/**,build/**,deliverables/**,private/**,sources/**,qa_public/**,deploy/**,**/__pycache__/**,*.xlsx}"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
